# environment: dev | prod | test
# controls both local make-targets and the docker compose stack (default: prod)
GYM_ENV=dev

# docker compose / mysql
MYSQL_ROOT_PASSWORD=gym
MYSQL_DATABASE=gym
MYSQL_USER=gym
MYSQL_PASSWORD=gym
MYSQL_PORT=3306
REDIS_PORT=6379

# app ports
HTTP_PORT=8080
ASYNQMON_PORT=8081

# host dir for container logs (bind mount, visible in IDE)
# LOGS_DIR=./var/log/gym

# application overrides (GYM_* override config/<env>.yaml)
# GYM_LOGGER_LEVEL=info
# GYM_LOGGER_FORMAT=json
